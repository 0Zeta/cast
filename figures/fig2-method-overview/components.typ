#import "@preview/cetz:0.5.2": canvas, draw, decorations
#import "../shared/styles/illustration.typ": *

#let outline = (paint: line-gray, thickness: .50pt)
#let signal = (paint: blue, thickness: .62pt)
#let interval-stroke = (paint: blue, thickness: interval-width, cap: "round")
#let candidate-stroke = (paint: line-gray, thickness: interval-width, cap: "round")
#let zero-guide = (paint: line-gray, thickness: .25pt, dash: (1.6pt, 1.3pt))

// Reference bounds define the shared mini-card height. Each glyph derives its
// own centered bounds from that height rather than reusing these coordinates.
#let calibration-card-bottom = 1.40
#let calibration-card-top = 6.55

// Measured waveform from the paper's example clip.
#let waveform-source = read("../shared/assets/audio_waveform.tex")
#let waveform-matches = waveform-source.matches(regex("[0-9]+/([0-9]+\\.[0-9]+)"))
#let waveform-data = waveform-matches.map(match => float(match.captures.at(0)))
#assert.eq(waveform-data.len(), 144)

#let _bounds(w, h) = draw.rect((0, 0), (w, h), stroke: none, fill: none)

// Exact classic Computer Modern outlines generated by LaTeX's CMSY/CMMI fonts.
// The SVG is used instead of Typst font substitution for the paper's calligraphic I.
#let candidate-set-symbol() = box(
  baseline: 1.15pt,
  image("../shared/assets/mathcal_I_x.svg"),
)

#let _card(w, h, opaque: false) = {
  draw.rect(
    (0, 0),
    (w, h),
    radius: box-radius / 1mm,
    stroke: outline,
    fill: if opaque { white } else { standard-panel-fill },
  )
}

// A narrow label strip is part of the existing card, outside its data area.
#let panel-side-label(body, height, center-y: none, content-left: integrated-label-width / 1mm) = draw.content(
  (content-left / 2, if center-y == none { height / 2 } else { center-y }), angle: 90deg,
  label(body, size: type-compact, weight: "bold"),
)

#let clip-panel(width, height, bands: forgery-bands) = {
  let w = width / 1mm
  let h = height / 1mm
  canvas(length: 1mm, {
    _bounds(w, h)
    _card(w, h)

    panel-side-label([Input], h, content-left: (integrated-label-width + time-pad) / 1mm)
    let data-left = integrated-label-width / 1mm
    let data-w = w - data-left
    let p = time-pad / 1mm
    let inner-h = h - 2 * p
    let frame-side = inner-h / clip-frame-count
    let film-w = data-left + p + 1.2 + frame-side
    let wave-x = film-w + (w - film-w) / 2

    // Sample seven complete frames from the local twelve-frame raster. Each crop
    // is square and scales with the temporal height, preserving aspect ratio.
    let source-count = 12
    for cell in range(clip-frame-count) {
      let source-index = calc.round(cell * (source-count - 1) / (clip-frame-count - 1))
      let side = frame-side * 1mm
      draw.content(
        (data-left + p + .6, h - p - (cell + 1) * frame-side),
        (film-w - .6, h - p - cell * frame-side),
        block(width: side, height: side, clip: true)[
          #place(top + left, dy: -source-index * side,
            image("../shared/assets/frames_strip_vertical.png", width: side, height: source-count * side))
        ],
        padding: 0,
      )
    }

    draw.rect((data-left + p, p), (data-left + p + .7, h - p), fill: ink, stroke: none)
    draw.rect((film-w - .7, p), (film-w, h - p), fill: ink, stroke: none)
    for cell in range(clip-frame-count) {
      for slot in (0.18, 0.5, 0.82) {
        let y = h - p - (cell + slot) * inner-h / clip-frame-count
        draw.rect((data-left + p + .18, y - .14), (data-left + p + .52, y + .14), radius: .08, fill: white, stroke: none)
        draw.rect((film-w - .52, y - .14), (film-w - .18, y + .14), radius: .08, fill: white, stroke: none)
      }
    }

    // The input panel uses the shared 144-bar measured waveform.
    for (i, amplitude) in waveform-data.enumerate() {
      let f = (i + .5) / waveform-data.len()
      let y = h - p - f * inner-h
      let half = amplitude * data-w * .105
      let color = blue
      draw.line((wave-x - half, y), (wave-x + half, y), stroke: (paint: color, thickness: .38pt))
    }
  })
}

#let fusion-brace-glyph(width, height, height-scale: 1) = {
  let w = width / 1mm
  let h = height / 1mm
  canvas(length: 1mm, {
    _bounds(w, h)
    let brace-inset = .45
    let scale-inset = (1 - height-scale) * h / 2
    let brace-x = .20
    let amplitude = calc.max(.5, w - .4)
    decorations.flat-brace(
      (brace-x, h - brace-inset - scale-inset),
      (brace-x, brace-inset + scale-inset),
      amplitude: amplitude,
      curves: .58,
      outer-curves: .48,
      stroke: (paint: soft, thickness: .46pt, cap: "round", join: "round"),
      fill: none,
    )
  })
}

#let encoder-panel(
  width,
  height,
  show-family-formulas: true,
  show-frozen: true,
) = {
  let w = width / 1mm
  let h = height / 1mm
  canvas(length: 1mm, {
    _bounds(w, h)

    // Match the transform-side edge inset so both external stage gaps and both
    // internal encoder gaps derive from the same global stage-gap token.
    let funnel-x = 0
    let funnel-w = encoder-funnel-width / 1mm
    let streams-x = funnel-x + funnel-w + stage-gap / 1mm
    // The transform trapezoid reuses the encoder trapezoid's width and mirrors
    // its silhouette exactly. Deriving the representation width from the two
    // trapezoids leaves one standard stage gap on both sides of A/V/J.
    let streams-w = embedding-width / 1mm
    let transform-left = streams-x + streams-w + .8
    let transform-right = transform-left + 2
    // Both trapezoids share two space-evenly text lanes. With rotated text these
    // are the first and second lines in reading order.
    let primary-lane = .30
    let secondary-lane = .70

    // One geometry source of truth guarantees that the two trapezoids remain
    // exact mirrors when their shared dimensions are edited later.
    let trapezoid(x, mirrored: false) = {
      let left-inset = if mirrored { 1.7 } else { .25 }
      let right-inset = if mirrored { .25 } else { 1.7 }
      draw.line(
        (x, left-inset),
        (x + funnel-w, right-inset),
        (x + funnel-w, h - right-inset),
        (x, h - left-inset),
        close: true,
        fill: rgb("#e8eef3"),
        stroke: outline,
      )
    }

    trapezoid(funnel-x)
    draw.content((funnel-x + funnel-w * primary-lane, h / 2), angle: 90deg,
      label([Feature Encoding], size: type-compact, weight: "bold"))
    let avhubert-lane = secondary-lane
    draw.content(
      (funnel-x + funnel-w * avhubert-lane, h / 2),
      angle: 90deg,
      label([AV-HuBERT], size: type-body),
    )
    if show-frozen {
      draw.content(
        (funnel-x + funnel-w * secondary-lane, h / 2),
        angle: 90deg,
        label([frozen], size: type-body, color: soft),
      )
    }

    let labs = ([Audio], [Video], [Joint])
    for (i, lab) in labs.enumerate() {
      let top = h - 1.6 - i * (h - 3.2) / 3
      let bottom = h - 1.6 - (i + 1) * (h - 3.2) / 3 + .8
      draw.rect(
        (streams-x, bottom),
        (streams-x + streams-w, top - .8),
        radius: box-radius / 1mm,
        fill: white,
        stroke: outline,
      )
      draw.content((streams-x + streams-w / 2, (top + bottom - .8) / 2),
        angle: 90deg, text(font: "Nimbus Roman", style: "italic", size: type-body, fill: soft, lab))
    }

    draw.content(
      (transform-left, 0), (transform-right, h),
      fusion-brace-glyph((transform-right - transform-left) * 1mm, height),
      padding: 0,
    )
  })
}

#let _evidence(f, seed, strength, bands) = {
  let responses = bands.map(band => {
    let center = (band.at(0) + band.at(1)) / 2
    let scale = (band.at(1) - band.at(0)) * .42
    calc.exp(-calc.pow((f - center) / scale, 2))
  })
  calc.min(
    1,
    .07 + .78 * strength * responses.sum() +
      .11 * calc.abs(calc.sin((f * 2100 + seed * 57) * 1deg)),
  )
}

// Smooth box responses aligned to the exact figure-level forgery intervals.
// These make the standardized y tracks read as sustained fake evidence instead
// of isolated Gaussian bumps.
#let _soft-window(f, band, edge: .012) = {
  let enter = 1 / (1 + calc.exp(-(f - band.at(0)) / edge))
  let leave = 1 / (1 + calc.exp((f - band.at(1)) / edge))
  enter * leave
}

#let _fake-response(f, bands) = calc.min(
  1,
  bands.map(band => _soft-window(f, band)).sum(),
)

#let _band-flanks(f, band, width: .035) = {
  let left = (band.at(0) - width, band.at(0))
  let right = (band.at(1), band.at(1) + width)
  _soft-window(f, left, edge: .007) + _soft-window(f, right, edge: .007)
}

#let _flank-response(f, bands) = calc.min(
  1,
  bands.map(band => _band-flanks(f, band)).sum(),
)

// Reusable stacked card: the front renderer receives its usable width and height.
// Offset outlines in both directions; preserve the renderer's temporal scale.
#let stacked-card(width, height, render, layers: 3, offset: .4mm) = {
  let front-width = width - (layers - 1) * offset
  let front-height = height - (layers - 1) * offset
  let w = front-width / 1mm
  let h = front-height / 1mm
  let r = box-radius / 1mm
  let d = offset / 1mm
  let rounded-path(x, y) = {
    ("M " + str(x + r) + " " + str(y) +
    " H " + str(x + w - r) + " Q " + str(x + w) + " " + str(y) + " " + str(x + w) + " " + str(y + r) +
    " V " + str(y + h - r) + " Q " + str(x + w) + " " + str(y + h) + " " + str(x + w - r) + " " + str(y + h) +
    " H " + str(x + r) + " Q " + str(x) + " " + str(y + h) + " " + str(x) + " " + str(y + h - r) +
    " V " + str(y + r) + " Q " + str(x) + " " + str(y) + " " + str(x + r) + " " + str(y) + " Z ")
  }
  // One compound path paints the union once, so overlapping cards cannot
  // accumulate opacity. Rear outlines contain only exposed right/bottom edges.
  let silhouette = range(layers).map(i => rounded-path(i * d, i * d)).join(" ")
  let edges = range(1, layers).rev().map(i => {
    let x = i * d
    let y = i * d
    let occluders = range(i).map(j => rounded-path(j * d, j * d)).join(" ")
    ("<defs><mask id='rear-" + str(i) + "' maskUnits='userSpaceOnUse' x='-1' y='-1' width='" + str(width / 1mm + 2) + "' height='" + str(height / 1mm + 2) + "'>" +
      "<rect x='-1' y='-1' width='" + str(width / 1mm + 2) + "' height='" + str(height / 1mm + 2) + "' fill='white'/>" +
      "<path d='" + occluders + "' fill='black'/></mask></defs>" +
      "<path d='" + rounded-path(x, y) + "' mask='url(#rear-" + str(i) + ")' fill='none' stroke='" + line-gray.to-hex() + "' stroke-width='" + str(.50pt / 1mm) + "'/>")
  }).join(" ")
  // Include the outward half-stroke on every edge without scaling the artwork.
  let bleed = .25pt
  let svg-width = width + 2 * bleed
  let svg-height = height + 2 * bleed
  let svg = ("<svg xmlns='http://www.w3.org/2000/svg' width='" + str(svg-width / 1mm) + "mm' height='" + str(svg-height / 1mm) + "mm' viewBox='" + str(-bleed / 1mm) + " " + str(-bleed / 1mm) + " " + str(svg-width / 1mm) + " " + str(svg-height / 1mm) + "'>" +
    "<path d='" + silhouette + "' fill='white' fill-opacity='0.7'/>" +
    edges + "<path d='" + rounded-path(0, 0) + "' fill='none' stroke='" + line-gray.to-hex() + "' stroke-width='" + str(.50pt / 1mm) + "' stroke-linecap='round'/>" +
    "</svg>")
  block(width: width, height: height)[
    #place(top + left, dx: -bleed, dy: -bleed,
      // Typst formats negative numbers with Unicode minus; SVG needs ASCII.
      image(bytes(svg.replace("−", "-")), width: svg-width, height: svg-height))
    #place(top + left, render(front-width, height))
  ]
}

#let score-value(f, bands) = {
  let noise = .045 * calc.sin((f * 95 * 31 + 82) * 1deg)
  noise - .31 * _fake-response(f, bands) + .30 * _flank-response(f, bands)
}

// Both the full score and its excerpt use this physical amplitude scale.
#let score-amplitude(width) = (width - 2 * time-pad) / 1mm

// Temporal coordinates shared by the full score and magnification connectors.
#let score-time-y(height, f) = {
  let h = height / 1mm
  let p = time-pad / 1mm
  h - p - f * (h - 2 * p)
}

#let whitened-score-graph(width, height, bands: forgery-bands) = {
  let w = width / 1mm
  let h = height / 1mm
  canvas(length: 1mm, {
    _bounds(w, h)
    let p = time-pad / 1mm
    let data-left = integrated-label-width / 1mm
    let data-w = w - data-left
    let zero-x = data-left + data-w / 2
    let graph-w = score-amplitude(width - integrated-label-width)
    let curve-left = zero-x + graph-w * calc.min(..range(192).map(i => score-value(i / 191, bands))) - .85pt / 1mm / 2
    panel-side-label([Score Sequences], h, content-left: curve-left)
    // The stack supplies the same translucent white fill as other panels.
    draw.content((w - .6, h - .55),
      label([$times 6$], size: type-compact, color: soft), anchor: "north-east")
    draw.line((zero-x, p), (zero-x, h - p), stroke: zero-guide)
    let points = range(0, 192).map(i => {
      let f = i / 191
      (zero-x + graph-w * score-value(f, bands), score-time-y(height, f))
    })
    draw.line(..points, stroke: (paint: blue, thickness: .85pt))
  })
}

#let score-panel(width, height, bands: forgery-bands) = stacked-card(
  integrated-label-width + small-card-width + .8mm, height,
  (w, h) => whitened-score-graph(w, h, bands: bands),
)

// Five evenly spaced slots: candidates occupy 1, 2, 3, 5; the ellipsis uses 4.
#let candidate-slot-x(width, slot) = {
  let p = time-pad / 1mm
  let slot-width = (width / 1mm - 2 * p) / 5
  p + (slot + .5) * slot-width
}
#let candidate-lane-x(width, lane) = candidate-slot-x(width, (0, 1, 2, 4).at(lane))

#let candidate-panel(width, height) = {
  let w = (integrated-label-width + small-card-width) / 1mm
  let h = height / 1mm
  canvas(length: 1mm, {
    _bounds(w, h)
    _card(w, h)
    // Keep the caption between the two diagonal magnification connectors.
    panel-side-label([Candidate Intervals], h, center-y: .5 * h,
      content-left: integrated-label-width / 1mm + candidate-lane-x(small-card-width, 0) - interval-width / 1mm / 2)
    let data-left = integrated-label-width / 1mm
    let p = time-pad / 1mm
    let ih = h - 2 * p
    let lanes = 4
    let lane-x(lane) = data-left + candidate-lane-x(small-card-width, lane)
    let divisions = candidate-divisions
    // All columns share a physical gap; divide the remaining length equally.
    for lane in range(0, lanes) {
      let x = lane-x(lane)
      let count = divisions.at(lane)
      for i in range(0, count) {
        let (start, end) = candidate-interval(lane, i)
        draw.line(
          (x, h - p - start * ih),
          (x, h - p - end * ih),
          stroke: (paint: candidate-color(lane, i), thickness: interval-width, cap: "round"),
        )
      }
    }
    // The fourth slot holds only the centered, larger horizontal ellipsis.
    let ellipsis-x = data-left + candidate-slot-x(small-card-width, 3)
    let dot-gap = calc.min(.5, (lane-x(3) - lane-x(2)) / 5)
    for offset in (-1, 0, 1) {
      draw.circle((ellipsis-x + offset * dot-gap, h / 2),
        radius: .15, fill: ink, stroke: none)
    }
  })
}

#let template-glyph(kind, name, show-name: true, side-length: 6.0) = canvas(length: 1mm, {
  // Keep the square itself unchanged. When its label is suppressed, center the
  // square in the same fixed-height row canvas.
  let side = side-length
  let glyph-scale = side / 6.0
  let w = if show-name { 10.0 } else { side }
  let center-x = w / 2
  let card-left = (w - side) / 2
  let card-right = card-left + side
  let h = 7.65
  let card-bottom = if show-name { 1.50 } else { (h - side) / 2 }
  let card-top = card-bottom + side
  let y0 = (card-bottom + card-top) / 2
  let y-hi = y0 + 1.30 * glyph-scale
  let y-lo = y0 - 1.30 * glyph-scale
  let x-left = center-x - 1.375 * glyph-scale
  let x-right = center-x + 1.375 * glyph-scale
  let x-q1 = x-left + (x-right - x-left) / 4
  let x-q3 = x-left + 3 * (x-right - x-left) / 4
  _bounds(w, h)
  draw.rect(
    (card-left, card-bottom),
    (card-right, card-top),
    radius: box-radius / 1mm,
    fill: white,
    stroke: (paint: line-gray, thickness: .35pt),
  )
  draw.line((card-left, y0), (card-right, y0), stroke: zero-guide)

  if kind == "mean2" {
    // Mean filter; squaring makes positive and negative departures equivalent.
    draw.line(
      (card-left, y0), (x-left, y0), (x-left, y-hi),
      (x-right, y-hi), (x-right, y0), (card-right, y0),
      stroke: (paint: orange, thickness: .62pt),
    )
  } else if kind == "mean-down" {
    // Upper-tail orientation of -z_mu: a decrease inside I is anomalous.
    draw.line(
      (card-left, y0), (x-left, y0), (x-left, y-lo),
      (x-right, y-lo), (x-right, y0), (card-right, y0),
      stroke: (paint: orange, thickness: .62pt),
    )
  } else if kind == "edge-center2" {
    // Positive outer quarters, negative middle half; zero-sum on I.
    draw.line(
      (card-left, y0), (x-left, y0), (x-left, y-hi),
      (x-q1, y-hi), (x-q1, y-lo), (x-q3, y-lo),
      (x-q3, y-hi), (x-right, y-hi), (x-right, y0), (card-right, y0),
      stroke: (paint: orange, thickness: .62pt),
    )
  } else if kind == "ar-down" {
    // Oriented AR(1)-whitened mean: positive outside notches, deep negative
    // endpoints, and a shallower negative interior.
    draw.line(
      (card-left, y0),
      (x-left - .75 * glyph-scale, y0),
      (x-left - .45 * glyph-scale, y-hi),
      (x-left - .18 * glyph-scale, y0),
      (x-left, y-lo - .35 * glyph-scale),
      (x-left + .32 * glyph-scale, y-lo + .65 * glyph-scale),
      (x-right - .32 * glyph-scale, y-lo + .65 * glyph-scale),
      (x-right, y-lo - .35 * glyph-scale),
      (x-right + .18 * glyph-scale, y0),
      (x-right + .45 * glyph-scale, y-hi),
      (x-right + .75 * glyph-scale, y0),
      (card-right, y0),
      stroke: (paint: orange, thickness: .62pt),
    )
  } else if kind == "flank-down" {
    // Upper-tail orientation of -z_if: positive immediate flanks and a
    // negative candidate interval.
    draw.line(
      (card-left, y0),
      (x-left - 1.25 * glyph-scale, y0),
      (x-left - 1.25 * glyph-scale, y-hi),
      (x-left, y-hi),
      (x-left, y-lo), (x-right, y-lo),
      (x-right, y-hi),
      (x-right + 1.25 * glyph-scale, y-hi),
      (x-right + 1.25 * glyph-scale, y0),
      (card-right, y0),
      stroke: (paint: orange, thickness: .62pt),
    )
  }
  if show-name {
    draw.content((center-x, .43), label(name, size: type-compact))
  }
})

// Genuine bars, inserted samples, and extracted samples share both endpoints.
#let calibration-sample-span(value, card-bottom) = {
  let bottom = card-bottom + .68
  (bottom: bottom, top: bottom + .52 + 3.08 * value)
}

#let calibration-singleton(body, color, value, width: 2.35, show-marker: true, vertical-shift: 0) = canvas(length: 1mm, {
  let w = width
  let h = 7.65
  // Match the array canvas so extracted and inserted sample endpoints align.
  draw.rect((0, -2), (w, h), stroke: none, fill: none)
  let marker-x = w - .35
  let card-bottom = (h - (calibration-card-top - calibration-card-bottom)) / 2 + vertical-shift
  let sample = calibration-sample-span(value, card-bottom)
  let marker-y = sample.top
  draw.content(
    (0, (h - 2) / 2),
    text(font: math-font, size: type-compact, fill: ink, body),
    anchor: "west",
  )
  if show-marker { draw.line(
    (marker-x, sample.bottom),
    (marker-x, marker-y - .28),
    stroke: (paint: color, thickness: .40pt, dash: (.70pt, .55pt)),
  )
  draw.circle(
    (marker-x, marker-y),
    radius: .25,
    fill: color.lighten(60%),
    stroke: (paint: color, thickness: .43pt),
  ) }
})

#let calibration-pill(removed-index: 12, vertical-shift: 0) = canvas(length: 1mm, {
  let w = 10.6
  let h = 7.65
  draw.rect((0, -2), (w, h), stroke: none, fill: none)
  let rank-left = 0
  let rank-right = w
  // Match the neighboring normalization card in height and center the full
  // calibration array card in the row canvas with equal top/bottom margins.
  let rank-height = calibration-card-top - calibration-card-bottom
  let rank-bottom = (h - rank-height) / 2 + vertical-shift
  let rank-top = rank-bottom + rank-height
  let query = removed-index / 19
  let query-x = rank-left + query * (rank-right - rank-left)

  // Sorted genuine scores; all references to the right of z_I form the upper
  // tail count R. The repeated row makes calibration visibly template-specific.
  draw.rect(
    (rank-left, rank-bottom),
    (rank-right, rank-top),
    radius: box-radius / 1mm,
    fill: white,
    stroke: (paint: line-gray, thickness: .28pt),
  )
  // Eighteen increasingly tall sorted bars; no baseline competes with them.
  for index in range(1, 19) {
    if index != removed-index {
      let ref = index / 19
      let x = rank-left + ref * (rank-right - rank-left)
      let exceeds = ref > query
      let sample = calibration-sample-span(ref, rank-bottom)
      draw.line(
        (x, sample.bottom),
        (x, sample.top),
        stroke: (
          paint: if exceeds { orange } else { line-gray },
          thickness: .48pt,
          cap: "round",
        ),
      )
    }
  }
  // Insert z_I at both its sorted horizontal position and its corresponding
  // bar height, so different rows visibly carry different query statistics.
  let sample = calibration-sample-span(query, rank-bottom)
  let marker-y = sample.top
  draw.line(
    (query-x, sample.bottom),
    (query-x, marker-y - .28),
    stroke: (paint: orange, thickness: .40pt, dash: (.70pt, .55pt)),
  )
  draw.circle(
    (query-x, marker-y),
    radius: .25,
    fill: orange.lighten(58%),
    stroke: (paint: orange, thickness: .42pt),
  )

})

#let normalization-glyph(box-shift: 0, formula-position-shift: 0) = canvas(length: 1mm, {
  let w = 4.9
  let h = 7.65
  let card-height = calibration-card-top - calibration-card-bottom
  let card-bottom = (h - card-height) / 2 + box-shift
  let card-top = card-bottom + card-height
  let row-center = h / 2
  // Keep the native math fraction intact and tune only its optical position
  // within the fixed, centered card. Negative CeTZ y moves it downward.
  let formula-shift = -.10
  _bounds(w, h)
  draw.rect(
    (0, card-bottom),
    (w, card-top),
    radius: box-radius / 1mm,
    fill: white,
    stroke: (paint: line-gray, thickness: .32pt),
  )
  draw.content(
    (w / 2, row-center + formula-shift + formula-position-shift),
    text(font: math-font, size: type-compact, fill: ink, [$frac(R + 1, N + 1)$]),
  )
})

#let scan-templates = (
  (kind: "mean2", name: [$"mean"^2$], removed: 13),
  (kind: "mean-down", name: [$"mean" arrow.b$], removed: 15),
  (kind: "edge-center2", name: [$"edge–center"^2$], removed: 4),
  (kind: "ar-down", name: [$"AR-whitened" arrow.b$], removed: 12),
  (kind: "flank-down", name: [$"interval–flank" arrow.b$], removed: 17),
)

#let fusion-radius = 1.8mm
#let fusion-plus-glyph(width, height, show-label: false, center-y: none) = {
  let w = width / 1mm
  let h = height / 1mm
  canvas(length: 1mm, {
    _bounds(w, h)
    let x = w / 2
    let y = if center-y == none { h / 2 } else { center-y }
    draw.circle(
      (x, y),
      radius: fusion-radius / 1mm,
      fill: white,
      stroke: (paint: line-gray, thickness: .46pt),
    )
    draw.content((x, y), text(font: math-font, size: 8pt, fill: ink)[$Sigma$])
    if show-label {
      draw.content((x, y - 3.4), label([Fuse], size: type-body, color: soft),
        anchor: "north")
    }
  })
}

// Resolve the same fractional tracks for both drawing and header placement.
#let track-widths(width, tracks) = {
  let fixed = tracks.filter(t => type(t) == length).sum(default: 0mm)
  let flex = tracks.filter(t => type(t) == fraction).map(t => t / 1fr).sum()
  tracks.map(t => if type(t) == fraction { (width - fixed) * (t / 1fr) / flex } else { t })
}
#let track-center(widths, index) = widths.slice(0, index).sum(default: 0mm) + widths.at(index) / 2
// Each box has its own horizontal tracks; both share the same four-row area.
#let scan-zoom-width = 9mm
#let scan-left-inset = 3.2mm
#let scan-right-inset = .8mm
#let scan-zoom-gap = 1mm
#let scan-template-size = 6.6mm
#let score-singleton-width = 2.9mm
#let calibration-inset = .8mm
#let scoring-inset-y = 1.1mm
#let scoring-header-height = 3mm
#let scoring-header-gap = .45mm
#let scan-tracks = (
  2fr, scan-template-size, 1fr, .9mm, 1fr, score-singleton-width, 1fr,
)
#let calibration-pvalue-width() = measure(text(font: math-font, size: type-compact, [$p_1$])).width
#let calibration-tracks() = (
  1fr, 10.6mm, 1fr, 1.2mm, 1fr, calibration-pvalue-width(), 1fr,
)
#let visible-scan-templates = scan-templates.slice(1)

#let scan-row-geometry(width) = {
  let rows-left = scan-left-inset + scan-zoom-width + scan-zoom-gap
  let tracks = track-widths(width - rows-left - scan-right-inset - .4mm, scan-tracks)
  let offset = rows-left + .2mm
  (
    filter-center: offset + track-center(tracks, 1),
    arrow-start: offset + track-center(tracks, 3) - .6mm - 1.035mm,
    arrow-end: offset + track-center(tracks, 3) - .6mm + 1.035mm,
    output-right: offset + tracks.slice(0, 6).sum(),
  )
}
#let calibration-row-geometry(width) = {
  let tracks = track-widths(width - 2 * calibration-inset, calibration-tracks())
  (
    array-left: calibration-inset + tracks.first(),
    array-center: calibration-inset + track-center(tracks, 1),
    arrow-start: calibration-inset + track-center(tracks, 3) - .6mm,
    arrow-end: calibration-inset + track-center(tracks, 3) + .6mm,
    output-right: calibration-inset + tracks.slice(0, 6).sum(),
  )
}

// Row labels, connecting arrows, and fusion use the same vertical coordinates.
#let scoring-center-y(height) = (height - scoring-header-height - scoring-header-gap) / 2 / 1mm
#let scoring-row-y(height, row) = {
  let top = (height - scoring-inset-y - scoring-header-height - scoring-header-gap) / 1mm
  let body-height = (height - 2 * scoring-inset-y - scoring-header-height - scoring-header-gap) / 1mm
  top - (row + .5) * body-height / visible-scan-templates.len()
}
#let fusion-panel(width, height) = fusion-plus-glyph(width, height,
  show-label: true, center-y: scoring-center-y(height))

// Keep the original row centers and sample endpoints identical in both boxes.
#let scoring-rows(width, height, tracks, cells, inset: .2mm) = block(
  width: width, height: height, inset: (x: inset, y: scoring-inset-y),
  grid(columns: (1fr,), rows: (scoring-header-height, 1fr), row-gutter: scoring-header-gap,
    align: center,
    [],
    block(width: 100%, height: 100%)[
      #grid(columns: tracks, rows: visible-scan-templates.map(_ => 1fr),
        column-gutter: 0mm, row-gutter: 0mm, align: center + horizon,
        ..cells)
    ],
  ),
)

#let scan-filter-rows(width, height) = {
  let cells = visible-scan-templates.enumerate().map(((row, item)) => (
    grid.cell(x: 1, y: row,
      move(dx: -1.147mm, rotate(90deg, template-glyph(item.kind, item.name,
        show-name: false, side-length: scan-template-size / 1mm)))),
    grid.cell(x: 5, y: row,
      calibration-singleton([$z_#(row + 1)$], orange, item.removed / 19,
        vertical-shift: -.75, width: score-singleton-width / 1mm)),
  )).flatten()
  scoring-rows(width, height, scan-tracks, cells)
}

#let calibration-panel(width, height) = {
  let tracks = calibration-tracks()
  let cells = visible-scan-templates.enumerate().map(((row, item)) => (
    grid.cell(x: 1, y: row,
      calibration-pill(removed-index: item.removed, vertical-shift: -.75)),
    grid.cell(x: 5, y: row,
      calibration-singleton([$p_#(row + 1)$], blue, item.removed / 19,
        show-marker: false, width: calibration-pvalue-width() / 1mm)),
  )).flatten()
  block(width: width, height: height, radius: box-radius,
    stroke: outline, fill: white)[
    #place(top + left, dy: scoring-inset-y,
      block(width: 100%, height: scoring-header-height,
        align(center + horizon, label([Calibrate], size: 6pt, weight: "bold"))))
    #scoring-rows(width, height, tracks, cells, inset: calibration-inset)
  ]
}

// One definition of the excerpt's time limits and its vertical drawing bounds.
#let interval-score-geometry(height, bands) = {
  let interval = bands.at(1)
  let row-center-shift = (scoring-header-height + scoring-header-gap) / 2 / 1mm
  (
    lo: interval.at(0) - .06,
    hi: interval.at(1) + .06,
    bottom: 8 - row-center-shift,
    top: height / 1mm - 8 - row-center-shift,
  )
}

// Exact excerpt of the shared illustrative score, including both flanks.
#let interval-score-zoom(width, height, bands) = {
  let w = width / 1mm
  let h = height / 1mm
  // The excerpt magnifies time while retaining the full score's amplitude.
  let graph-w = score-amplitude(small-card-width)
  let interval = bands.at(1)
  let excerpt = interval-score-geometry(height, bands)
  let lo = excerpt.lo
  let hi = excerpt.hi
  let bottom = excerpt.bottom
  let top = excerpt.top
  let y(f) = top - (f - lo) / (hi - lo) * (top - bottom)
  canvas(length: 1mm, {
    _bounds(w, h)
    draw.rect((0, bottom), (w, top), radius: box-radius / 1mm,
      fill: white, stroke: outline)
    draw.rect((0, y(interval.at(1))), (w, y(interval.at(0))),
      fill: band-fill, stroke: none)
    draw.line((w / 2, bottom), (w / 2, top), stroke: zero-guide)
    let points = range(192).map(i => {
      let f = lo + i / 191 * (hi - lo)
      (w / 2 + graph-w * score-value(f, bands), y(f))
    })
    draw.line(..points, stroke: (paint: blue, thickness: .85pt))
  })
}

#let scan-panel(width, height, bands: forgery-bands) = {
  block(width: width, height: height, radius: box-radius,
    stroke: outline, fill: white)[
    #place(top + left, dx: scan-left-inset, dy: scoring-inset-y,
      block(width: scan-zoom-width, height: scoring-header-height,
        align(center + horizon, label([Scan], size: 6pt, weight: "bold"))))
    #place(top + left, dx: scan-row-geometry(width).filter-center - scan-template-size / 2 - 1.147mm,
      dy: scoring-inset-y,
      block(width: scan-template-size, height: scoring-header-height,
        align(center + horizon, label([Filter], size: 6pt, weight: "bold"))))
    #block(width: 100%, height: 100%,
      inset: (left: scan-left-inset, right: scan-right-inset, y: 0mm))[
      #grid(columns: (scan-zoom-width, 1fr), column-gutter: scan-zoom-gap,
        align: center + horizon,
        move(dx: -1.48mm, interval-score-zoom(scan-zoom-width, height, bands)),
        layout(size => scan-filter-rows(size.width, height)),
      )
    ]
  ]
}
