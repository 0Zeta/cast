{
  "name": "fakeavceleb_avpf_trimmed",
  "references": [
    {
      "title": "Audio-Visual Temporal Forgery Localization without Training on Deepfakes",
      "file": "CITATION.cff",
      "role": "method"
    },
    {
      "title": "FakeAVCeleb: A Novel Audio-Video Multimodal Deepfake Dataset",
      "url": "https://arxiv.org/abs/2108.05080",
      "role": "dataset"
    },
    {
      "title": "Generalizing Video Deepfake Detection by Self-Generated Audio-Visual Pseudo-Fakes",
      "url": "https://arxiv.org/abs/2604.09110",
      "role": "matched_comparison"
    }
  ],
  "population": {
    "dataset": "FakeAVCeleb",
    "split": "AVPF released comparison",
    "selection": "Released AVPF clip list joined to available local media.",
    "cohort_file": "configs/cohorts/fakeavceleb_avpf_released_6667.csv.gz"
  },
  "preprocessing": {
    "encoders": [
      "large_vox_iter5.pt",
      "self_large_vox_433h.pt"
    ],
    "audio_sample_rate": 16000,
    "max_frames": 750,
    "leading_silence_trim": true,
    "trim_order": "trim_then_cap"
  },
  "fitting": {
    "reference_source": "AV-Deepfake1M genuine training clips after source-speaker exclusion",
    "partition": "Three speaker-disjoint fitting, calibration, and fusion pools.",
    "ranker_training_data": "Controlled-corruption corpus built from genuine AV-Deepfake1M training sources.",
    "fusion_split": "2:1:1 over the fusion pool, using recorded clip sampling identities."
  },
  "inputs": {
    "base_dir": "${CAST_WORK_DIR}",
    "scores_main": "scores/fakeavceleb_avpf_trimmed_main.npz",
    "scores_sync": "scores/fakeavceleb_avpf_trimmed_sync.npz",
    "scores_avsr": "scores/fakeavceleb_avpf_trimmed_avsr.npz",
    "scores_artifact": "scores/fakeavceleb_avpf_trimmed_artifact.npz",
    "labels_csv": "manifests/fakeavceleb_avpf.csv",
    "ref_scores_main": "scores/avdeepfake1m_reference_main.npz",
    "ref_scores_sync": "scores/avdeepfake1m_reference_sync.npz",
    "ref_scores_avsr": "scores/avdeepfake1m_reference_avsr.npz",
    "ref_scores_artifact": "scores/avdeepfake1m_reference_artifact.npz",
    "ref_labels_csv": "manifests/avdeepfake1m_reference.csv",
    "ref_exclude_csv": "manifests/reference_exclusion.csv",
    "self_splice_corpus": "models/self_splice_corpus.npz",
    "out_dir": "runs/fakeavceleb_avpf_trimmed",
    "main_groups": [
      "cross_modal_agreement"
    ],
    "avsr_groups": [
      "audio_side_avsr_agreement",
      "video_side_avsr_agreement"
    ],
    "artifact_groups": [
      "visual_artifact_score",
      "audio_artifact_score"
    ],
    "sync_groups": [
      "synchrony_residual"
    ],
    "missing_rows": "raise"
  },
  "config": "configs/method.json",
  "ranking": {
    "ranker": "models/proposal_ranker_avdeepfake1m_external_reference.json",
    "proposals": "proposals_learned_rescored.csv"
  },
  "evaluation": {
    "detection": {
      "unit": "speaker",
      "resampling": "index",
      "seed": 0,
      "batch_size": 64
    },
    "localization": false,
    "views": {},
    "metrics": {
      "detection": [
        "roc_auc",
        "average_precision",
        "eer",
        "tpr_at_fpr",
        "fpr_at_tpr",
        "exact_rank_rates"
      ],
      "localization": []
    }
  }
}
